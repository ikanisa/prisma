{
    "name": "@prisma/accounting-canada",
    "version": "1.0.0",
    "description": "Canada Accounting Autonomous AI Agent System - IFRS/ASPE dual standards with Quebec bilingual support",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "rm -rf dist .turbo",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "openai": "^4.77.0"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.3.0",
        "vitest": "^1.6.0"
    },
    "keywords": [
        "canada",
        "accounting",
        "ifrs",
        "aspe",
        "cpa-canada",
        "quebec",
        "bilingual",
        "ai-agent"
    ],
    "engines": {
        "node": ">=18"
    }
}