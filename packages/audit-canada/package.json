{
    "name": "@prisma/audit-canada",
    "version": "1.0.0",
    "description": "Canada Audit Autonomous AI Agent System - CAS-based audit framework with CPAB inspection readiness",
    "private": true,
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        }
    },
    "scripts": {
        "build": "tsc -b",
        "clean": "rm -rf dist .turbo",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest watch"
    },
    "dependencies": {
        "openai": "^4.77.0",
        "@prisma/accounting-canada": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "typescript": "^5.3.0",
        "vitest": "^1.6.0"
    },
    "keywords": [
        "canada",
        "audit",
        "cas",
        "cpa-canada",
        "cpab",
        "isa",
        "risk-assessment",
        "ai-agent"
    ],
    "engines": {
        "node": ">=18"
    }
}