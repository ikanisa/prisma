            "assigneeRole": "MANAGER",
            "estimatedHours": 3,
            "dependencies": [
                "tax-3",
                "tax-4",
                "tax-5"
            ]
        },
        {
            "id": "tax-7",
            "phaseId": "filing",
            "title": "CFR submission",
            "description": "Submit to Commissioner for Revenue",
            "assigneeRole": "PARTNER",
            "estimatedHours": 2,
            "dependencies": [
                "tax-6"
            ]
        }
