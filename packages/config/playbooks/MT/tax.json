{
    "jurisdiction": "MT",
    "engagementType": "tax",
    "version": "1.0.0",
    "phases": [
        {
            "id": "data_collection",
            "name": "Data Collection",
            "order": 1,
            "reviewGate": null,
            "requiredForCompletion": true
        },
        {
            "id": "computation",
            "name": "Tax Computation",
            "order": 2,
            "reviewGate": "MANAGER",
            "requiredForCompletion": true
        },
        {
            "id": "filing",
            "name": "Filing & Submission",
            "order": 3,
            "reviewGate": "PARTNER",
            "requiredForCompletion": true
        }
    ],
    "taskTemplates": [
        {
            "id": "tax-1",
            "phaseId": "data_collection",
            "title": "Gather accounting records",
            "description": "Collect trial balance, workings, and EU sales/trade data where applicable",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": []
        },
        {
            "id": "tax-8",
            "phaseId": "data_collection",
            "title": "Collect EU cross-border sales data",
            "description": "Gather EU B2C/B2B sales for OSS/IOSS assessment",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": [
                "tax-1"
            ],
            "optional": true
        },
        {
            "id": "tax-9",
            "phaseId": "data_collection",
            "title": "Collect Intrastat trade data",
            "description": "Compile EU arrivals/dispatches for Intrastat",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": [
                "tax-1"
            ],
            "optional": true
        },
        {
            "id": "tax-2",
            "phaseId": "computation",
            "title": "Corporate tax computation",
            "description": "Calculate CIT at 35% with imputation credits",
            "assigneeRole": "STAFF",
            "estimatedHours": 8,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-3",
            "phaseId": "computation",
            "title": "NID calculation",
            "description": "Calculate Notional Interest Deduction",
            "assigneeRole": "STAFF",
            "estimatedHours": 4,
            "dependencies": [
                "tax-2"
            ]
        },
        {
            "id": "tax-4",
            "phaseId": "computation",
            "title": "VAT return computation",
            "description": "Prepare VAT return at 18%, including OSS/IOSS and SME scheme checks where applicable",
            "assigneeRole": "STAFF",
            "estimatedHours": 4,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-10",
            "phaseId": "computation",
            "title": "SME scheme eligibility check",
            "description": "Assess Article 10/11/11A/11B thresholds and VAT registration status",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": [
                "tax-1"
            ],
            "optional": true
        },
        {
            "id": "tax-11",
            "phaseId": "computation",
            "title": "OSS/IOSS return draft",
            "description": "Prepare OSS/IOSS VAT draft based on EU sales data",
            "assigneeRole": "STAFF",
            "estimatedHours": 3,
            "dependencies": [
                "tax-8"
            ],
            "optional": true
        },
        {
            "id": "tax-12",
            "phaseId": "computation",
            "title": "Intrastat declaration draft",
            "description": "Prepare Intrastat declarations for EU trade",
            "assigneeRole": "STAFF",
            "estimatedHours": 3,
            "dependencies": [
                "tax-9"
            ],
            "optional": true
        },
        {
            "id": "tax-5",
            "phaseId": "computation",
            "title": "Refund entitlement",
            "description": "Calculate 6/7ths or 5/7ths refund entitlements",
            "assigneeRole": "STAFF",
            "estimatedHours": 4,
            "dependencies": [
                "tax-2"
            ]
        },
        {
            "id": "tax-6",
            "phaseId": "filing",
            "title": "Manager review",
            "description": "Review all computations",
            "assigneeRole": "MANAGER",
            "estimatedHours": 3,
            "dependencies": [
                "tax-3",
                "tax-4",
                "tax-5"
            ]
        },
        {
            "id": "tax-13",
            "phaseId": "filing",
            "title": "OSS/IOSS submission",
            "description": "Submit OSS/IOSS returns where required",
            "assigneeRole": "MANAGER",
            "estimatedHours": 2,
            "dependencies": [
                "tax-6",
                "tax-11"
            ],
            "optional": true
        },
        {
            "id": "tax-14",
            "phaseId": "filing",
            "title": "Intrastat submission",
            "description": "Submit Intrastat declarations",
            "assigneeRole": "MANAGER",
            "estimatedHours": 2,
            "dependencies": [
                "tax-6",
                "tax-12"
            ],
            "optional": true
        },
        {
            "id": "tax-7",
            "phaseId": "filing",
            "title": "CFR submission",
            "description": "Submit to Commissioner for Revenue",
            "assigneeRole": "PARTNER",
            "estimatedHours": 2,
            "dependencies": [
                "tax-6"
            ]
        }
    ],
    "docRequestTemplates": [
        {
            "id": "doc-1",
            "docType": "trial_balance",
            "description": "Trial balance for tax period",
            "required": true,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-2",
            "docType": "financial_statement",
            "description": "Audited or management accounts",
            "required": true,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-3",
            "docType": "shareholder_register",
            "description": "Shareholder register for refund claims",
            "required": true,
            "phaseId": "computation"
        },
        {
            "id": "doc-4",
            "docType": "eu_sales_ledger",
            "description": "EU cross-border sales ledger for OSS/IOSS (if applicable)",
            "required": false,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-5",
            "docType": "intrastat_trade_data",
            "description": "EU arrivals/dispatches data for Intrastat (if applicable)",
            "required": false,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-6",
            "docType": "vat_registration_certificate",
            "description": "CFR VAT registration certificate (if applicable)",
            "required": false,
            "phaseId": "data_collection"
        }
    ],
    "mandatoryWorkpapers": [
        "cit_computation",
        "nid_calculation",
        "vat_computation",
        "refund_calculation",
        "tax_return_draft"
    ]
}
