    "taskTemplates": [
        {
            "id": "tax-1",
            "phaseId": "data_collection",
            "title": "Gather accounting records",
            "description": "Collect trial balance and workings",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": []
        },
        {
            "id": "tax-2",
            "phaseId": "computation",
            "title": "Corporate tax computation",
            "description": "Calculate CIT at 35% with imputation credits",
            "assigneeRole": "STAFF",
            "estimatedHours": 8,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-3",
            "phaseId": "computation",
            "title": "NID calculation",
            "description": "Calculate Notional Interest Deduction",
            "assigneeRole": "STAFF",
            "estimatedHours": 4,
            "dependencies": [
                "tax-2"
            ]
        },
        {
            "id": "tax-4",
            "phaseId": "computation",
            "title": "VAT return computation",
            "description": "Prepare VAT return at 18%",
            "assigneeRole": "STAFF",
            "estimatedHours": 4,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-5",
            "phaseId": "computation",
            "title": "Refund entitlement",
            "description": "Calculate 6/7ths or 5/7ths refund entitlements",
