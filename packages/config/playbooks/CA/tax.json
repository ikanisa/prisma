{
    "jurisdiction": "CA",
    "engagementType": "tax",
    "version": "1.0.0",
    "phases": [
        {
            "id": "data_collection",
            "name": "Data Collection",
            "order": 1,
            "reviewGate": null,
            "requiredForCompletion": true
        },
        {
            "id": "computation",
            "name": "Tax Computation",
            "order": 2,
            "reviewGate": "MANAGER",
            "requiredForCompletion": true
        },
        {
            "id": "filing",
            "name": "Filing & Submission",
            "order": 3,
            "reviewGate": "PARTNER",
            "requiredForCompletion": true
        }
    ],
    "taskTemplates": [
        {
            "id": "tax-1",
            "phaseId": "data_collection",
            "title": "Gather accounting records",
            "description": "Collect trial balance, T-slips, and sales by province where applicable",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": []
        },
        {
            "id": "tax-8",
            "phaseId": "data_collection",
            "title": "Provincial nexus assessment",
            "description": "Assess GST/HST/PST/QST nexus by province and confirm registrations",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": [
                "tax-1"
            ],
            "optional": true
        },
        {
            "id": "tax-2",
            "phaseId": "computation",
            "title": "Corporate tax computation",
            "description": "Calculate federal and provincial CIT",
            "assigneeRole": "STAFF",
            "estimatedHours": 8,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-3",
            "phaseId": "computation",
            "title": "GST/HST return",
            "description": "Prepare GST/HST return for CRA, validate provincial treatment, and document ITCs",
            "assigneeRole": "STAFF",
            "estimatedHours": 4,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-9",
            "phaseId": "computation",
            "title": "ITC documentation review",
            "description": "Validate ITC eligibility and supporting documentation",
            "assigneeRole": "STAFF",
            "estimatedHours": 3,
            "dependencies": [
                "tax-3"
            ],
            "optional": true
        },
        {
            "id": "tax-10",
            "phaseId": "computation",
            "title": "Aboriginal exemption review",
            "description": "Review GST/HST exemptions for Indigenous/Aboriginal transactions where applicable",
            "assigneeRole": "STAFF",
            "estimatedHours": 2,
            "dependencies": [
                "tax-3"
            ],
            "optional": true
        },
        {
            "id": "tax-4",
            "phaseId": "computation",
            "title": "Payroll reconciliation",
            "description": "Reconcile T4 summaries and remittances",
            "assigneeRole": "STAFF",
            "estimatedHours": 4,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-5",
            "phaseId": "computation",
            "title": "SRED credits",
            "description": "Evaluate SR&ED eligibility if applicable",
            "assigneeRole": "STAFF",
            "estimatedHours": 6,
            "dependencies": [
                "tax-2"
            ]
        },
        {
            "id": "tax-6",
            "phaseId": "filing",
            "title": "Manager review",
            "description": "Review all computations",
            "assigneeRole": "MANAGER",
            "estimatedHours": 3,
            "dependencies": [
                "tax-2",
                "tax-3",
                "tax-4"
            ]
        },
        {
            "id": "tax-7",
            "phaseId": "filing",
            "title": "CRA submission",
            "description": "Submit T2 and GST/HST returns to CRA",
            "assigneeRole": "PARTNER",
            "estimatedHours": 2,
            "dependencies": [
                "tax-6"
            ]
        }
    ],
    "docRequestTemplates": [
        {
            "id": "doc-1",
            "docType": "trial_balance",
            "description": "Trial balance for tax period",
            "required": true,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-2",
            "docType": "t_slips",
            "description": "T4, T4A, T5 slips",
            "required": true,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-3",
            "docType": "financial_statement",
            "description": "Year-end financial statements",
            "required": true,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-4",
            "docType": "sales_by_province",
            "description": "Sales by province/territory (for GST/HST/PST/QST assessment)",
            "required": false,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-5",
            "docType": "itc_supporting_docs",
            "description": "Supporting invoices for ITC claims (if applicable)",
            "required": false,
            "phaseId": "data_collection"
        },
        {
            "id": "doc-6",
            "docType": "provincial_registrations",
            "description": "Provincial registration details (PST/QST/HST as applicable)",
            "required": false,
            "phaseId": "data_collection"
        }
    ],
    "mandatoryWorkpapers": [
        "cit_computation",
        "gst_hst_return",
        "payroll_reconciliation",
        "tax_return_draft"
    ]
}
