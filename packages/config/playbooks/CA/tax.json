            "estimatedHours": 2,
            "dependencies": []
        },
        {
            "id": "tax-2",
            "phaseId": "computation",
            "title": "Corporate tax computation",
            "description": "Calculate federal and provincial CIT",
            "assigneeRole": "STAFF",
            "estimatedHours": 8,
            "dependencies": [
                "tax-1"
            ]
        },
        {
            "id": "tax-3",
            "phaseId": "computation",
            "title": "GST/HST return",
            "description": "Prepare GST/HST return for CRA",
