FROM node:20-alpine AS builder

WORKDIR /app

# Install pnpm
RUN npm install -g pnpm

# Copy workspace files
COPY pnpm-workspace.yaml ./
COPY package.json pnpm-lock.yaml ./
COPY apps/gateway/package.json ./apps/gateway/
COPY packages/agents/package.json ./packages/agents/
COPY packages/logger/package.json ./packages/logger/
COPY config/ ./config/

# Install dependencies
RUN pnpm install --frozen-lockfile

# Copy source
COPY apps/gateway/ ./apps/gateway/
COPY packages/agents/ ./packages/agents/
COPY packages/logger/ ./packages/logger/

# Build
RUN pnpm --filter @prisma/agents build
RUN pnpm --filter @prisma/gateway build

# Production
FROM node:20-alpine AS runner

WORKDIR /app

RUN npm install -g pnpm

COPY --from=builder /app/package.json ./
COPY --from=builder /app/pnpm-workspace.yaml ./
COPY --from=builder /app/pnpm-lock.yaml ./
COPY --from=builder /app/apps/gateway/ ./apps/gateway/
COPY --from=builder /app/packages/agents/ ./packages/agents/
COPY --from=builder /app/packages/logger/ ./packages/logger/
COPY --from=builder /app/config/ ./config/
COPY --from=builder /app/node_modules/ ./node_modules/

WORKDIR /app/apps/gateway

ENV NODE_ENV=production
ENV PORT=8080

EXPOSE 8080

CMD ["pnpm", "start"]
