# Environment Variables - Prisma Glow
# 
# Copy this file to .env.local and fill in the values
# 
# See docs/ENV_GUIDE.md for detailed documentation

# ===========================================
# Required: Supabase Configuration
# ===========================================

# Supabase project URL (from Dashboard → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous key (safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Supabase service role key (server-side only, never expose to client)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ===========================================
# Required: Application Configuration
# ===========================================

# Application URL
NEXT_PUBLIC_APP_URL=https://prisma.ikanisa.com

# Node environment
NODE_ENV=development

# ===========================================
# Optional: OpenAI Integration
# ===========================================

# OpenAI API key for AI agent features
OPENAI_API_KEY=sk-...

# OpenAI OAuth credentials (for ChatKit)
OPENAI_APP_OAUTH_CLIENT_ID=your-client-id
OPENAI_APP_OAUTH_CLIENT_SECRET=your-secret
OPENAI_OAUTH_TOKEN_URL=https://openai.com/oauth/token

# ===========================================
# Optional: Feature Flags
# ===========================================

# Enable AI features (disable if no OPENAI_API_KEY)
ENABLE_AI_FEATURES=true

# Enable audit logging
AUDIT_LOGGING_ENABLED=true

# ===========================================
# Security Configuration
# ===========================================

# NEVER set to true in production
SUPABASE_ALLOW_STUB=false

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# Enable RLS (should always be true)
SUPABASE_RLS_ENABLED=true

# Rate limiting (should always be true in production)
RATE_LIMITING_ENABLED=true

# ===========================================
# Build-time Variables
# ===========================================

# Set by CI/CD
BUILD_NUMBER=
COMMIT_SHA=
BRANCH=
