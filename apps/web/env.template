# =============================================================================
# Environment Variables Template for Prisma Glow Web App
# =============================================================================
# Copy this file to .env.local for local development
# DO NOT commit .env.local to git (it's in .gitignore)
# =============================================================================

# -----------------------------------------------------------------------------
# Application Configuration
# -----------------------------------------------------------------------------
# Base URL of the application
# Local: http://localhost:3000
# Production: https://prisma.pages.dev
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Application version (optional, can be Git SHA)
NEXT_PUBLIC_APP_VERSION=local

# -----------------------------------------------------------------------------
# Supabase Configuration
# -----------------------------------------------------------------------------
# Supabase project URL
# Get from: Supabase Dashboard > Settings > API > Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anonymous/public key (safe to expose in client)
# Get from: Supabase Dashboard > Settings > API > anon public key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# -----------------------------------------------------------------------------
# OpenAI App OAuth (Server-side only)
# -----------------------------------------------------------------------------
# These are used in API routes, not exposed to the client
# Get from: OpenAI Platform > Your App > OAuth Settings
OPENAI_APP_OAUTH_CLIENT_ID=your-client-id
OPENAI_APP_OAUTH_CLIENT_SECRET=your-client-secret

# Optional: Custom OAuth token URL (defaults to OpenAI's)
# OPENAI_OAUTH_TOKEN_URL=https://api.openai.com/v1/oauth/token

# -----------------------------------------------------------------------------
# Sentry Error Tracking (Optional)
# -----------------------------------------------------------------------------
# Sentry DSN for error tracking
# Get from: Sentry Dashboard > Settings > Projects > Client Keys (DSN)
# NEXT_PUBLIC_SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# -----------------------------------------------------------------------------
# Node Environment
# -----------------------------------------------------------------------------
# Automatically set by Next.js, but can be overridden
# Values: development, production, test
NODE_ENV=development

# -----------------------------------------------------------------------------
# Notes
# -----------------------------------------------------------------------------
# - All NEXT_PUBLIC_* variables are exposed to the browser (public)
# - Variables without NEXT_PUBLIC_ are server-side only
# - Never commit secrets or API keys to git
# - For production, set these in Cloudflare Pages Dashboard:
#   Dashboard > Pages > prisma > Settings > Environment variables

