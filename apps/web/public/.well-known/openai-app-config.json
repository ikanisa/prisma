{
  "name": "Prisma Glow",
  "description": "AI-powered audit, tax, and accounting operations platform with intelligent agents, knowledge management, and automated workflows",
  "version": "3.0.0",
  "author": "Prisma Glow",
  "homepage_url": "https://prisma-glow.pages.dev",
  "support_url": "https://prisma-glow.pages.dev/support",
  "privacy_url": "https://prisma-glow.pages.dev/privacy",
  "terms_url": "https://prisma-glow.pages.dev/terms",
  "icon_url": "https://prisma-glow.pages.dev/icons/icon-512.png",
  "categories": ["business", "productivity", "finance", "accounting"],
  "tags": ["accounting", "audit", "tax", "ai", "automation", "compliance", "financial-reporting"],
  "features": [
    "AI-powered audit workflows",
    "Tax calculation and compliance",
    "Knowledge base management",
    "Document processing",
    "Multi-agent orchestration",
    "Real-time collaboration",
    "RAG-enhanced search",
    "Automated reporting",
    "Agent Builder workflows",
    "ChatKit widgets",
    "File search integration",
    "Web search capabilities"
  ],
  "capabilities": {
    "file_search": true,
    "web_search": true,
    "function_calling": true,
    "streaming": true,
    "realtime": true,
    "chatkit_widgets": true,
    "multi_agent": true,
    "agent_builder": true,
    "mcp_server": true
  },
  "oauth": {
    "client_id": "${OPENAI_APP_OAUTH_CLIENT_ID}",
    "scopes": ["openid", "profile", "email"],
    "authorization_url": "https://auth.openai.com/oauth/authorize",
    "token_url": "https://api.openai.com/v1/oauth/token"
  },
  "api_endpoints": {
    "base_url": "https://prisma-glow.pages.dev/api",
    "auth": "/auth/openai/callback",
    "chat": "/api/agent/chat",
    "stream": "/api/agent/stream",
    "realtime": "/api/agent/realtime/session",
    "chatkit": "/api/agent/chatkit/session",
    "agent_builder": "/api/agent/builder",
    "files": "/api/files",
    "knowledge": "/api/knowledge",
    "widgets": "/api/widgets",
    "mcp": "/api/mcp"
  },
  "ui": {
    "theme": "light",
    "primary_color": "#4A90E2",
    "background_color": "#ffffff",
    "text_color": "#1a1a1a",
    "iframe_compatible": true,
    "mobile_responsive": true,
    "accessibility": {
      "wcag_aa": true,
      "keyboard_navigation": true,
      "screen_reader_support": true
    }
  },
  "metadata": {
    "min_api_version": "1.0.0",
    "supported_models": ["gpt-4", "gpt-4-turbo", "gpt-4o", "gpt-4o-mini", "gpt-4o-realtime-preview"],
    "requires_auth": true,
    "supports_team_workspaces": true,
    "supports_webhooks": true,
    "supports_state_management": true,
    "rate_limits": {
      "chat": "20/min",
      "stream": "10/min",
      "realtime": "10/min",
      "file_search": "30/min"
    }
  },
  "widgets": {
    "supported_types": ["button", "text", "image", "file", "form", "card", "table", "chart", "list", "accordion"],
    "action_types": ["submit", "navigate", "callback", "open_url"]
  },
  "agent_builder": {
    "enabled": true,
    "workflow_export": true,
    "template_support": true,
    "preview_mode": true
  }
}
