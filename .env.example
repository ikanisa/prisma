# =============================================================================
# REQUIRED: Supabase Configuration
# =============================================================================
# Get these from: Supabase Dashboard > Settings > API
# CRITICAL: Do not commit actual values to git

# Frontend Configuration (Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Frontend Configuration (Next.js)
# Supabase Configuration (Frontend - Vite App)
# REQUIRED: These are used by the Vite frontend application
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# Supabase Configuration (Frontend - Next.js App)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend Configuration (Python FastAPI & Node.js services)
# Supabase Configuration (Backend - Python FastAPI)
# REQUIRED: These are validated at startup
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# CRITICAL: Required for JWT validation in production
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard
SUPABASE_JWT_AUDIENCE=authenticated

# Management
SUPABASE_PROJECT_ID=your-project-id
SUPABASE_ACCESS_TOKEN=your-access-token

# Security Configuration
ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
API_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Gateway CORS - REQUIRED in production
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Production example: GATEWAY_ALLOWED_ORIGINS=https://app.prismaglow.com,https://staging.prismaglow.com

# Application URL
NEXT_PUBLIC_APP_URL=https://prisma-glow.pages.dev

# Cloudflare Configuration (optional - for CI/CD)
# CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
# CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# OpenAI Configuration
OPENAI_API_KEY=your-openai-api-key
OPENAI_ORG_ID=your-org-id

# OpenAI Agents SDK Configuration
# Model to use with the Agents SDK (default: gpt-4o)
OPENAI_AGENTS_MODEL=gpt-4o

# Gemini AI Configuration
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-pro

# Google Gemini ADK Configuration
# Alternatively use GOOGLE_API_KEY (both work)
GOOGLE_API_KEY=your-google-api-key
GEMINI_ADK_MODEL=gemini-2.0-flash

# Vertex AI Configuration (for production Gemini ADK)
VERTEX_AI_PROJECT=your-gcp-project-id
VERTEX_AI_LOCATION=us-central1

# =============================================================================
# Monitoring & Error Tracking
# =============================================================================
# REQUIRED for production: Error tracking and monitoring
# Get DSN from: Sentry Dashboard > Settings > Client Keys

# Frontend Sentry Configuration
NEXT_PUBLIC_SENTRY_DSN=your-sentry-dsn
VITE_SENTRY_DSN=your-sentry-dsn

# Backend Sentry Configuration
SENTRY_DSN=your-sentry-dsn
SENTRY_AUTH_TOKEN=your-sentry-auth-token
SENTRY_ORG=prisma-glow
SENTRY_PROJECT=client
SENTRY_ENVIRONMENT=production

# =============================================================================
# Database & Cache
# =============================================================================
# PostgreSQL Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=prisma_glow

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password

# =============================================================================
# Rate Limiting (Production)
# =============================================================================
# Configure rate limits for API endpoints
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW=60
# Backend Sentry DSN (Python FastAPI)
SENTRY_DSN=your-backend-sentry-dsn
SENTRY_ENVIRONMENT=production
SENTRY_RELEASE=1.0.0

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
